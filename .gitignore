# Python Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# WhatsApp Decrypted Databases & Media (CRITICAL PRIVACY)
# Never commit personal chats, decrypted SQLite databases, or private media!
output/
Media/
Databases/
Backups/
contacts_map.json
encrypted_backup.key

# Configuration files with personal keys
# Use config.json.example as the public template
config.json

